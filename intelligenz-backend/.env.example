# --- Database (Postgres) ---
# Get a free one at https://neon.tech (also installable directly from the
# Vercel dashboard: Storage tab -> Create Database -> Postgres, powered by Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Flask session security ---
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# --- Admin dashboard login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# --- Gmail SMTP (for OTP emails) ---
# SMTP_EMAIL is the Gmail address that will send OTPs.
# SMTP_PASSWORD is a 16-character Gmail "App Password" (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the Gmail account)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=youraccount@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# --- Event branding ---
EVENT_NAME=INTELLIGENZ 2K26
